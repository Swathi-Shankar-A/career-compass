<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Career Recommendation System for B.Tech CSE Students</display-name>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- =================================================================== -->
    <!-- FILTERS                                                             -->
    <!-- =================================================================== -->

    <!-- Student Authentication Filter -->
    <filter>
        <filter-name>StudentAuthFilter</filter-name>
        <filter-class>com.career.filter.StudentAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>StudentAuthFilter</filter-name>
        <url-pattern>/student/*</url-pattern>
    </filter-mapping>

    <!-- Admin Authentication Filter -->
    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.career.filter.AdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- =================================================================== -->
    <!-- PUBLIC & AUTH SERVLETS                                              -->
    <!-- =================================================================== -->

    <!-- Session Status API -->
    <servlet>
        <servlet-name>SessionServlet</servlet-name>
        <servlet-class>com.career.servlet.SessionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SessionServlet</servlet-name>
        <url-pattern>/api/session</url-pattern>
    </servlet-mapping>

    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.career.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Student Registration -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.career.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Student Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.career.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Student & General Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.career.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- =================================================================== -->
    <!-- STUDENT PROTECTED SERVLETS (/student/*)                            -->
    <!-- =================================================================== -->

    <!-- Student Dashboard -->
    <servlet>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <servlet-class>com.career.servlet.StudentDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <url-pattern>/student/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Assessment Flow (20 Questions) -->
    <servlet>
        <servlet-name>AssessmentServlet</servlet-name>
        <servlet-class>com.career.servlet.AssessmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssessmentServlet</servlet-name>
        <url-pattern>/student/assessment</url-pattern>
    </servlet-mapping>

    <!-- Recommendation Results -->
    <servlet>
        <servlet-name>RecommendationResultsServlet</servlet-name>
        <servlet-class>com.career.servlet.RecommendationResultsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecommendationResultsServlet</servlet-name>
        <url-pattern>/student/results</url-pattern>
    </servlet-mapping>

    <!-- Career Details -->
    <servlet>
        <servlet-name>CareerDetailsServlet</servlet-name>
        <servlet-class>com.career.servlet.CareerDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CareerDetailsServlet</servlet-name>
        <url-pattern>/student/career-details</url-pattern>
    </servlet-mapping>

    <!-- Student Profile -->
    <servlet>
        <servlet-name>StudentProfileServlet</servlet-name>
        <servlet-class>com.career.servlet.StudentProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentProfileServlet</servlet-name>
        <url-pattern>/student/profile</url-pattern>
    </servlet-mapping>

    <!-- Student Assessment History -->
    <servlet>
        <servlet-name>StudentHistoryServlet</servlet-name>
        <servlet-class>com.career.servlet.StudentHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentHistoryServlet</servlet-name>
        <url-pattern>/student/history</url-pattern>
    </servlet-mapping>

    <!-- =================================================================== -->
    <!-- ADMIN SERVLETS (/admin/*)                                           -->
    <!-- =================================================================== -->

    <!-- Admin Login -->
    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.career.servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin/login</url-pattern>
    </servlet-mapping>

    <!-- Admin Logout -->
    <servlet>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <servlet-class>com.career.servlet.AdminLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <url-pattern>/admin/logout</url-pattern>
    </servlet-mapping>

    <!-- Admin Dashboard -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.career.servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Admin Question Management -->
    <servlet>
        <servlet-name>AdminQuestionsServlet</servlet-name>
        <servlet-class>com.career.servlet.AdminQuestionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminQuestionsServlet</servlet-name>
        <url-pattern>/admin/questions</url-pattern>
    </servlet-mapping>

    <!-- Admin Student List -->
    <servlet>
        <servlet-name>AdminStudentsServlet</servlet-name>
        <servlet-class>com.career.servlet.AdminStudentsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminStudentsServlet</servlet-name>
        <url-pattern>/admin/students</url-pattern>
    </servlet-mapping>

    <!-- Admin Student Response Viewer -->
    <servlet>
        <servlet-name>AdminStudentResponsesServlet</servlet-name>
        <servlet-class>com.career.servlet.AdminStudentResponsesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminStudentResponsesServlet</servlet-name>
        <url-pattern>/admin/student-responses</url-pattern>
    </servlet-mapping>

    <!-- Admin Career Management -->
    <servlet>
        <servlet-name>AdminCareersServlet</servlet-name>
        <servlet-class>com.career.servlet.AdminCareersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminCareersServlet</servlet-name>
        <url-pattern>/admin/careers</url-pattern>
    </servlet-mapping>

    <!-- =================================================================== -->
    <!-- ERROR PAGES                                                         -->
    <!-- =================================================================== -->

    <error-page>
        <error-code>404</error-code>
        <location>/errors/404.html</location>
    </error-page>

    <error-page>
        <error-code>403</error-code>
        <location>/errors/403.html</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/errors/500.html</location>
    </error-page>

</web-app>
